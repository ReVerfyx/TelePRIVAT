TELEPRIVAT_DOMAIN=api.example.com
POSTGRES_DB=teleprivat
POSTGRES_USER=teleprivat
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgres://teleprivat:CHANGE_ME_DATABASE_PASSWORD@db:5432/teleprivat
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
PORT=8080
PROFILE_CACHE_MAX_BYTES=32212254720
NODE_ENV=production

TELEGRAM_RESOLVER_URL=http://telegram-resolver:8090
TELEGRAM_RESOLVER_TOKEN=CHANGE_ME_RESOLVER_TOKEN
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=CHANGE_ME_API_HASH
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN

# MTProto proxy used by the Telegram profile resolver.
TELEGRAM_PROXY_HOST=proxy.example.com
TELEGRAM_PROXY_PORT=443
TELEGRAM_PROXY_SECRET=CHANGE_ME_MTPROTO_SECRET
